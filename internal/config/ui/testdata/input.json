{
 "tabs": [
  {
   "name": "bots",
   "query": "is:open is:pr author:app/renovate",
   "sections": [
    {
     "name": "can merge",
     "merge": [
      "ready"
     ]
    },
    {
     "draft": true,
     "show": "excluded"
    }
   ]
  },
  {
   "kind": "inbox"
  }
 ],
 "list": {
  "refresh": "90s",
  "bell": true,
  "home_owners": [
   "acme"
  ]
 },
 "merge": {
  "methods": [
   "squash",
   "merge"
  ]
 },
 "keys": {
  "approve": "ctrl+a",
  "up": [
   "up",
   "k",
   "ctrl+p"
  ],
  "hide": []
 },
 "claude": {
  "language": "Japanese",
  "instructions": "Answer in short.\nName files with 'quotes' and \\ backslashes.",
  "mcp": {
   "builtin": true,
   "servers": {
    "recall": {
     "command": "recall",
     "args": [
      "mcp",
      "--repo",
      "${GH_DESK_URL}"
     ],
     "tools": [
      "recall_search"
     ],
     "env": {
      "KEY.WITH.DOTS": "${VAR}"
     }
    },
    "remote": {
     "type": "http",
     "url": "https://example.com/mcp",
     "headers": {
      "X.Custom Header": "a \"quoted\" value"
     },
     "tools": [
      "read"
     ]
    }
   }
  }
 },
 "select": [
  {
   "name": "a \"quoted\" rule",
   "title": "(?i)^fix\\(deps\\)",
   "max_lines": 10
  }
 ],
 "exclude": [
  {
   "repos": [
    "old/*"
   ]
  }
 ],
 "auto_approve": [
  {
   "name": "bots",
   "authors": [
    "renovate"
   ],
   "dry_run": true
  }
 ]
}
